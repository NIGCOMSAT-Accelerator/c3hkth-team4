# Cached EO downloads and generated rasters. Large and reproducible —
# never committed. data/ itself is kept via .gitkeep files.
data/cache/*
data/derived/*
data/outbox/*
!data/cache/.gitkeep
!data/derived/.gitkeep
!data/outbox/.gitkeep

# Screenshot scratch copied into the cache dir for container-side inspection
data/cache/*.png
