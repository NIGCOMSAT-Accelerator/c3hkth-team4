# Copy to .env and adjust. Compose reads this file automatically.

LOG_LEVEL=INFO

# P10 demo safety mode: caches only, no outbound network, frozen scenario date.
DEMO_MODE=false
# DEMO_DATE=2026-08-09

# Alerts (P9). With SMTP_HOST unset, emails render to data/outbox/*.eml
# and are marked delivered_simulated.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
WEBHOOK_HMAC_SECRET=dev-secret-change-me
WEB_BASE_URL=http://localhost:5173
